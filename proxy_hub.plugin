def _log(msg):
    try:
        log(f"{TAG} {msg}")
    except Exception:
        pass


def _dp(v):
    return AndroidUtilities.dp(v)


def _color(hex_str):
    return jclass("android.graphics.Color").parseColor(hex_str)


def _safe_get(obj, key, default=None):
    if obj is None:
        return default
    try:
        val = obj.get(key)
        if val is not None:
            return val
    except Exception:
        pass
    return default


def _jlist(jl) -> list:
    return [jl.get(i) for i in range(jl.size())]


def _fmt_time(ts):
    try:
        ts = float(ts)
        if ts <= 0:
            return "ещё не было"
        return time.strftime("%d.%m %H:%M", time.localtime(ts))
    except Exception:
        return "—"


def _fmt_left(seconds):
    seconds = max(0, int(seconds))
    if seconds < 60:
        return "меньше минуты"
    m = seconds // 60
    if m < 60:
        return f"{m} мин"
    h, m = divmod(m, 60)
    if h < 24:
        return f"{h} ч {m} мин" if m else f"{h} ч"
    d, h = divmod(h, 24)
    return f"{d} д {h} ч" if h else f"{d} д"


