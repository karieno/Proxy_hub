def _info_fields(p):
    """Возвращает (addr, port, secret, user, password) для ProxyInfo любой версии."""
    try:
        return (
            str(p.address or ""),
            int(p.port or 0),
            str(p.secret or ""),
            str(p.username or ""),
            str(p.password or ""),
        )
    except Exception:
        pass
    try:
        s = p.settings
        return (
            str(s.getAddress() or ""),
            int(s.getPort() or 0),
            str(s.getSecret() or ""),
            "",
            "",
        )
    except Exception:
        return ("", 0, "", "", "")


def _proxy_key(addr, port, secret):
    return f"{addr}:{port}:{secret}"


def _proxy_list_snapshot():
    try:
        SharedConfig.loadProxyList()
    except Exception:
        pass
    try:
        return _jlist(SharedConfig.proxyList)
    except Exception:
        return []


def _notify_proxies_changed():
    def _do():
        nc = NotificationCenter.getGlobalInstance()
        try:
            nc.postNotificationName(NotificationCenter.proxySettingsChanged)
            return
        except Exception:
            pass
        try:
            from java.lang import Object
            nc.postNotificationName(NotificationCenter.proxySettingsChanged, jarray(Object)(0))
        except Exception:
            pass

    run_on_ui_thread(_do)


def _save_proxies():
    try:
        SharedConfig.saveProxyList()
    except Exception as e:
        _log(f"saveProxyList: {e}")


def _proxy_count():
    try:
        return int(SharedConfig.proxyList.size())
    except Exception:
        return len(_proxy_list_snapshot())


def _delete_one(p):
    owners = [(SharedConfig, "deleteProxy")]
    try:
        PC = jclass("com.exteragram.messenger.proxy.ProxyController").getInstance()
        owners += [(PC, "deleteProxy"), (PC, "removeProxy")]
    except Exception:
        pass
    for owner, name in owners:
        try:
            getattr(owner, name)(p)
            return True
        except Exception:
            continue
    return False


def _delete_proxies(proxies):
    """Удаляет прокси и проверяет по размеру списка, что они реально пропали.
    Возвращает число удалённых."""
    proxies = list(proxies)
    if not proxies:
        return 0
    before = _proxy_count()
    for p in proxies:
        _delete_one(p)
    after = _proxy_count()
    if before - after < len(proxies):
        # запасной путь: убираем объекты прямо из списка
        try:
            lst = SharedConfig.proxyList
            for p in proxies:
                try:
                    lst.remove(p)
                except Exception:
                    pass
        except Exception as e:
            _log(f"fallback delete: {e}")
        after = _proxy_count()
    _save_proxies()
    return max(0, before - after)


def _new_proxy_info(server, port, user, pwd, secret, scheme="proxy"):
    """Создаёт ProxyInfo. Сначала старый конструктор, затем ProxySettings (новые сборки)."""
    ProxyInfo = jclass("org.telegram.messenger.SharedConfig$ProxyInfo")
    try:
        return ProxyInfo(server, int(port), user or "", pwd or "", secret or "")
    except Exception:
        pass
    Uri = jclass("android.net.Uri")
    PS = jclass("org.telegram.utils.proxy.ProxySettings")
    uri = f"tg://{scheme}?server={server}&port={port}"
    if secret:
        uri += f"&secret={secret}"
    if user:
        uri += f"&user={user}"
    if pwd:
        uri += f"&pass={pwd}"
    ps = PS.fromUri(Uri.parse(uri))
    return ProxyInfo(ps) if ps is not None else None


def _add_proxy_object(info):
    try:
        SharedConfig.addProxy(info)
        return True
    except Exception:
        pass
    try:
        PC = jclass("com.exteragram.messenger.proxy.ProxyController").getInstance()
        PC.addProxy(info)
        return True
    except Exception as e:
        _log(f"addProxy failed: {e}")
        return False


def _add_web_proxy(url):
    try:
        Uri = jclass("android.net.Uri")
        PS = jclass("org.telegram.utils.proxy.ProxySettings")
        ProxyInfo = jclass("org.telegram.messenger.SharedConfig$ProxyInfo")
        PC = jclass("com.exteragram.messenger.proxy.ProxyController").getInstance()
        ps = PS.fromUri(Uri.parse(url))
        if ps is None:
            return False
        PC.addProxy(ProxyInfo(ps))
        return True
    except Exception as e:
        _log(f"webproxy add failed: {e}")
        return False


def _add_link(url, seen):
    """Добавляет прокси по ссылке. Возвращает 'added' | 'dup' | 'bad'."""
    u = url.replace("&amp;", "&").strip().rstrip(".,;")
    u = re.sub(r"^https?://(?:t\.me|telegram\.me)/", "tg://", u, flags=re.IGNORECASE)
    low = u.lower()
    try:
        parsed = urllib.parse.urlparse(u)
        q = urllib.parse.parse_qs(parsed.query)
    except Exception:
        return "bad"

    server = q.get("server", [""])[0]
    if not server:
        return "bad"
    secret = q.get("secret", [""])[0]

    if low.startswith("tg://webproxy"):
        key = f"web:{server}:{secret}"
        if key in seen:
            return "dup"
        if _add_web_proxy(u):
            seen.add(key)
            return "added"
        return "bad"

    port_str = q.get("port", ["0"])[0]
    if not port_str.isdigit() or int(port_str) <= 0:
        return "bad"
    port = int(port_str)
    key = _proxy_key(server, port, secret)
    if key in seen:
        return "dup"
    user = urllib.parse.unquote(q.get("user", [""])[0])
    pwd = urllib.parse.unquote(q.get("pass", [""])[0])
    scheme = "socks" if low.startswith("tg://socks") else "proxy"
    info = _new_proxy_info(server, port, user, pwd, secret, scheme)
    if info is None or not _add_proxy_object(info):
        return "bad"
    seen.add(key)
    return "added"


def _existing_keys():
    keys = set()
    for p in _proxy_list_snapshot():
        a, po, s, _, _ = _info_fields(p)
        keys.add(_proxy_key(a, po, s))
    return keys


# ════════════════════════════════════════════════════════════════════
#  Разбор источников
# ════════════════════════════════════════════════════════════════════

def parse_source(line):
    """
    Поддерживаемые форматы (по одному в строке):
      @channel
      https://t.me/channel
      t.me/channel topic=5          (топик форума)
      https://t.me/c/1234567890     (приватный канал, где вы состоите)
      dialog:-1001234567890[:topic] (служебный, ставится из меню чата)
    """
    s = (line or "").strip()
    if not s or s.startswith("#"):
        return None
    topic = 0
    m = re.search(r"topic[=:]\s*(\d+)", s, re.IGNORECASE)
    if m:
        topic = int(m.group(1))

    m = re.match(r"^dialog:(-?\d+)(?::(\d+))?$", s)
    if m:
        t = int(m.group(2) or 0)
        return {"kind": "dialog", "id": int(m.group(1)), "topic": t, "key": f"dialog:{m.group(1)}:{t}"}

    m = re.search(r"(?:t\.me|telegram\.me)/c/(\d+)", s, re.IGNORECASE)
    if m:
        did = -(1000000000000 + int(m.group(1)))
        return {"kind": "dialog", "id": did, "topic": topic, "key": f"dialog:{did}:{topic}"}

    m = re.search(r"(?:t\.me|telegram\.me)/([A-Za-z0-9_]{4,})", s, re.IGNORECASE)
    if not m:
        m = re.match(r"^@?([A-Za-z][A-Za-z0-9_]{3,})(?:\s|$)", s)
    if m:
        name = m.group(1)
        if name.lower() in ("proxy", "socks", "joinchat", "addstickers", "c", "s"):
            return None
        return {"kind": "username", "name": name, "topic": topic, "key": f"@{name.lower()}:{topic}"}
    return None


# ════════════════════════════════════════════════════════════════════
#  Парсер веб-источников
# ════════════════════════════════════════════════════════════════════

WEB_MAX_BYTES = 5_000_000


def normalize_web_url(line):
    """Приводит строку к ссылке для скачивания. Возвращает None, если не похоже на URL."""
    s = (line or "").strip()
    if not s or s.startswith("#"):
        return None
    s = s.split()[0]
    if not re.match(r"^https?://", s, re.IGNORECASE):
        if re.match(r"^(github\.com|gist\.github\.com|raw\.githubusercontent\.com|gitverse\.ru|[\w.-]+\.[a-z]{2,})/", s, re.IGNORECASE):
            s = "https://" + s
        else:
            return None
    # github blob -> raw
    m = re.match(r"^https?://github\.com/([^/]+)/([^/]+)/blob/(.+)$", s, re.IGNORECASE)
    if m:
        return f"https://raw.githubusercontent.com/{m.group(1)}/{m.group(2)}/{m.group(3)}"
    # публичный канал t.me/name -> веб-превью t.me/s/name (читается без входа)
    m = re.match(r"^https?://(?:t\.me|telegram\.me)/([A-Za-z0-9_]{4,})/?$", s, re.IGNORECASE)
    if m and m.group(1).lower() not in ("proxy", "socks", "joinchat", "s", "c"):
        return f"https://t.me/s/{m.group(1)}"
    return s


def _links_from_json(node, out=None, depth=0):
    out = [] if out is None else out
    if depth > 6:
        return out
    if isinstance(node, dict):
        server = node.get("server") or node.get("host") or node.get("address") or node.get("ip")
        if server:
            secret = str(node.get("secret") or "")
            port = node.get("port")
            via = node.get("via")
            if via:
                out.append(f"tg://webproxy?server={server}&secret={secret}")
            elif port:
                line = f"tg://{'proxy' if secret else 'socks'}?server={server}&port={port}"
                if secret:
                    line += f"&secret={secret}"
                user = node.get("user") or node.get("username")
                pwd = node.get("pass") or node.get("password")
                if user:
                    line += f"&user={urllib.parse.quote(str(user))}"
                if pwd:
                    line += f"&pass={urllib.parse.quote(str(pwd))}"
                out.append(line)
        for v in node.values():
            if isinstance(v, (dict, list)):
                _links_from_json(v, out, depth + 1)
    elif isinstance(node, list):
        for v in node:
            _links_from_json(v, out, depth + 1)
    return out


def extract_proxy_links(text):
    """Достаёт ссылки на прокси из текста любого формата: обычный текст, HTML,
    JSON-список, закодированные ссылки, base64-подписка."""
    if not text:
        return []
    text = text.replace("&amp;", "&")
    links = PROXY_LINK_RE.findall(text)
    if not links:
        un = urllib.parse.unquote(text)
        if un != text:
            links = PROXY_LINK_RE.findall(un)
    try:
        data = json.loads(text)
        links = links + _links_from_json(data)
    except Exception:
        pass
    if not links:
        blob = "".join(text.split())
        if len(blob) >= 40 and re.fullmatch(r"[A-Za-z0-9+/_=-]+", blob):
            try:
                padded = blob.replace("-", "+").replace("_", "/")
                padded += "=" * ((4 - len(padded) % 4) % 4)
                decoded = base64.b64decode(padded).decode("utf-8", errors="ignore")
                links = PROXY_LINK_RE.findall(decoded.replace("&amp;", "&"))
            except Exception:
                pass
    return links


def fetch_web_text(url, timeout=15):
    import requests

    r = requests.get(
        url,
        timeout=timeout,
        headers={"User-Agent": "Mozilla/5.0 (Linux; Android 14) ProxyHub/" + __version__},
    )
    r.raise_for_status()
    if len(r.content) > WEB_MAX_BYTES:
        raise ValueError("файл слишком большой")
    return r.content.decode("utf-8", errors="replace")


