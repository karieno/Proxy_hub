def _kv_row(ctx, parent, label):
    from android.widget import LinearLayout

    row = LinearLayout(ctx)
    row.setOrientation(0)
    row.setGravity(16)
    lab = _text(ctx, label, 14, Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
    row.addView(lab, _lp(0, -2, 1.0))
    val = _text(ctx, "—", 14, 0, bold=True)
    val.setGravity(5)
    row.addView(val, _lp(-2, -2))
    lp = _lp(-1, -2)
    lp.setMargins(0, _dp(10), 0, 0)
    parent.addView(row, lp)
    return row, val


def _create_wl(context, list_view, current_account, class_guid, resources_provider):
    from android.widget import LinearLayout

    GD = jclass("android.graphics.drawable.GradientDrawable")
    Orientation = jclass("android.graphics.drawable.GradientDrawable$Orientation")
    ui = {}
    black = Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)
    gray = Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2)

    root = LinearLayout(context)
    root.setOrientation(1)
    root.setPadding(_dp(12), _dp(4), _dp(12), _dp(8))

    # карточка «Информация о сети»
    info = LinearLayout(context)
    info.setOrientation(1)
    info.setPadding(_dp(18), _dp(16), _dp(18), _dp(16))
    info.addView(_text(context, "Информация о сети", 17, black, bold=True), _lp(-2, -2))
    _, ui["type"] = _kv_row(context, info, "Тип подключения")
    _, ui["status"] = _kv_row(context, info, "Статус")
    _, ui["net"] = _kv_row(context, info, "Сеть")
    ui["vpn_row"], vpn_val = _kv_row(context, info, "VPN")
    vpn_val.setText("включён — результат неточный")
    vpn_val.setTextColor(_color(WL_COLORS["warn"]))
    root.addView(info, _lp(-1, -2))
    ui["info"] = info

    # круглая кнопка
    btn = LinearLayout(context)
    btn.setOrientation(1)
    btn.setGravity(17)
    btn.setClickable(True)
    try:
        grad = GD(Orientation.TL_BR, jarray(jint)([_color(BRAND_2), _color(BRAND)]))
    except Exception:
        grad = GD()
        grad.setColor(_color(BRAND))
    grad.setShape(1)  # OVAL
    btn.setBackground(grad)
    try:
        btn.setElevation(float(_dp(6)))
    except Exception:
        pass
    ui["btn_main"] = _text(context, "ТЕСТ", 26, _color(HEADER_TEXT), bold=True)
    ui["btn_sub"] = _text(context, "Проверка", 13, _color(HEADER_TEXT))
    btn.addView(ui["btn_main"], _lp(-2, -2))
    btn.addView(ui["btn_sub"], _lp(-2, -2))
    btn.setOnClickListener(OnClickListener(lambda _v: _wl_start()))
    holder = LinearLayout(context)
    holder.setGravity(1)
    holder.setPadding(0, _dp(24), 0, _dp(24))
    holder.addView(btn, _lp(_dp(168), _dp(168)))
    root.addView(holder, _lp(-1, -2))

    # карточка результата
    res = LinearLayout(context)
    res.setOrientation(1)
    res.setGravity(1)
    res.setPadding(_dp(16), _dp(16), _dp(16), _dp(16))
    res.addView(_text(context, "Результат теста", 17, black, bold=True), _lp(-2, -2))
    pill = _text(context, "", 15, black, bold=True)
    pill.setGravity(17)
    pill.setPadding(_dp(16), _dp(12), _dp(16), _dp(12))
    plp = _lp(-1, -2)
    plp.setMargins(0, _dp(14), 0, 0)
    res.addView(pill, plp)
    ui["pill"] = pill
    ui["time"] = _text(context, "", 12, gray)
    tlp = _lp(-2, -2)
    tlp.setMargins(0, _dp(10), 0, 0)
    res.addView(ui["time"], tlp)

    tiles_row = LinearLayout(context)
    tiles_row.setOrientation(0)
    ui["tiles"], ui["cnt"] = [], []
    for label in ("Белый список", "Российские", "Нейтральные"):
        tile = LinearLayout(context)
        tile.setOrientation(1)
        tile.setGravity(1)
        tile.setPadding(_dp(4), _dp(14), _dp(4), _dp(12))
        cnt = _text(context, "—", 20, black, bold=True)
        cnt.setClickable(True)
        cnt.setOnClickListener(OnClickListener(lambda _v, i=len(ui["cnt"]): _wl_show_site_results(i)))
        tile.addView(cnt, _lp(-2, -2))
        lab = _text(context, label, 11, gray)
        lab.setSingleLine(True)
        tile.addView(lab, _lp(-2, -2))
        lp = _lp(0, -2, 1.0)
        lp.setMargins(_dp(3), 0, _dp(3), 0)
        tiles_row.addView(tile, lp)
        ui["tiles"].append(tile)
        ui["cnt"].append(cnt)
    rlp = _lp(-1, -2)
    rlp.setMargins(0, _dp(14), 0, 0)
    res.addView(tiles_row, rlp)
    root.addView(res, _lp(-1, -2))
    ui["res"] = res

    _set_row_params(root)
    ui["root"] = root
    _WL_UI.clear()
    _WL_UI.update(ui)
    return root


def _bind_wl(view, item, divider, adapter, list_view):
    _wl_apply()


WL_FACTORY = SimpleSettingFactory(_create_wl, _bind_wl, is_clickable=False, is_shadow=False)


# ════════════════════════════════════════════════════════════════════
#  Кнопка «Автопилот» (вкладка «Прокси»)
# ════════════════════════════════════════════════════════════════════

def _pilot_idle_text():
    p = _PLUGIN
    if p is not None:
        try:
            last = str(p.get_setting("pilot_last_short", "") or "")
            if last:
                return f"Последний запуск {_fmt_time(p.get_setting('pilot_last_ts', 0))} · {last}"
        except Exception:
            pass
    return "Сбор → дубликаты → пинг → очистка → сортировка → подключение"


def _pilot_apply():
    ui = _PILOT_UI
    if not ui:
        return
    try:
        running = bool(_PILOT["running"])
        ui["title"].setText("Остановить автопилот" if running else "Запустить автопилот")
        ui["sub"].setText((_PILOT["text"] or "Работаю…") if running else _pilot_idle_text())
        total = int(_PILOT["total"] or 0)
        frac = min(1.0, float(_PILOT["step"]) / total) if (running and total) else 0.0
        ui["bar"].setVisibility(0 if running else 4)
        ui["fill"].setLayoutParams(_lp(0, -1, max(frac, 0.001)))
        ui["rest"].setLayoutParams(_lp(0, -1, max(1.0 - frac, 0.001)))
    except Exception as e:
        _log(f"pilot apply: {e}")


def _create_pilot(context, list_view, current_account, class_guid, resources_provider):
    from android.view import View
    from android.widget import FrameLayout, ImageView, LinearLayout

    GD = jclass("android.graphics.drawable.GradientDrawable")
    Orientation = jclass("android.graphics.drawable.GradientDrawable$Orientation")
    Color = jclass("android.graphics.Color")
    ink = _color(HEADER_TEXT)

    root = LinearLayout(context)
    root.setOrientation(1)
    root.setPadding(_dp(12), _dp(8), _dp(12), _dp(4))

    card = LinearLayout(context)
    card.setOrientation(1)
    card.setClickable(True)
    card.setPadding(_dp(18), _dp(16), _dp(18), _dp(16))
    try:
        grad = GD(Orientation.TL_BR, jarray(jint)([_color(BRAND_2), _color(BRAND)]))
    except Exception:
        grad = _rounded(_color(BRAND), 22)
    grad.setCornerRadius(float(_dp(22)))
    card.setBackground(grad)

    top = LinearLayout(context)
    top.setOrientation(0)
    top.setGravity(16)  # CENTER_VERTICAL

    badge = FrameLayout(context)
    circle = GD()
    circle.setShape(1)  # OVAL
    circle.setColor(Color.argb(95, 255, 255, 255))
    badge.setBackground(circle)
    icon = ImageView(context)
    rid = _res_id(context, ["msg_retry", "msg_download", "msg_settings"])
    if rid:
        icon.setImageResource(rid)
    icon.setColorFilter(ink)
    FLP = jclass("android.widget.FrameLayout$LayoutParams")
    badge.addView(icon, FLP(_dp(26), _dp(26), 17))
    top.addView(badge, _lp(_dp(50), _dp(50)))

    col = LinearLayout(context)
    col.setOrientation(1)
    title = _text(context, "Запустить автопилот", 17, ink, bold=True)
    sub = _text(context, " ", 12, ink)
    sub.setAlpha(0.8)
    sub.setMaxLines(3)
    col.addView(title, _lp(-2, -2))
    col.addView(sub, _lp(-2, -2))
    clp = _lp(0, -2, 1.0)
    clp.setMargins(_dp(14), 0, 0, 0)
    top.addView(col, clp)
    card.addView(top, _lp(-1, -2))

    bar = LinearLayout(context)
    bar.setOrientation(0)
    bar.setBackground(_rounded(Color.argb(90, 255, 255, 255), 2))
    fill = View(context)
    fill.setBackground(_rounded(ink, 2))
    rest = View(context)
    bar.addView(fill, _lp(0, -1, 0.001))
    bar.addView(rest, _lp(0, -1, 1.0))
    blp = _lp(-1, _dp(4))
    blp.setMargins(0, _dp(14), 0, 0)
    card.addView(bar, blp)
    bar.setVisibility(4)  # INVISIBLE — место резервируем, чтобы строка не прыгала

    def on_click(_v):
        if _PLUGIN is not None:
            _PLUGIN._pilot_toggle()

    card.setOnClickListener(OnClickListener(on_click))
    try:
        card.setElevation(float(_dp(3)))
    except Exception:
        pass

    root.addView(card, _lp(-1, -2))
    _set_row_params(root)
    _PILOT_UI.clear()
    _PILOT_UI.update({"title": title, "sub": sub, "bar": bar, "fill": fill, "rest": rest})
    return root


def _bind_pilot(view, item, divider, adapter, list_view):
    _pilot_apply()


PILOT_FACTORY = SimpleSettingFactory(_create_pilot, _bind_pilot, is_clickable=False, is_shadow=False)
