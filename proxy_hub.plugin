# ════════════════════════════════════════════════════════════════════
#  Хуки
# ════════════════════════════════════════════════════════════════════

class _CreateViewHook(MethodHook):
    def __init__(self, plg):
        self._p = plg

    def after_hooked_method(self, param):
        self._p._add_action_buttons(param.thisObject)


class _CheckProxyListHook(MethodHook):
    def __init__(self, plg):
        self._p = plg

    def before_hooked_method(self, param):
        try:
            if int(self._p.get_setting("ping_mode", 0)) != 0:
                param.setResult(None)
        except Exception as e:
            _log(f"checkProxyList hook: {e}")


class _CellSetProxyHook(MethodHook):
    def __init__(self, plg):
        self._p = plg

    def after_hooked_method(self, param):
        try:
            info = param.args[0]
            if not info or not self._p.get_setting("show_geo", True):
                return
            addr = _info_fields(info)[0]
            tv = get_private_field(param.thisObject, "textView")
            if tv is None or not addr:
                return
            d = self._p._ip_cache.get(addr)
            if d:
                flag = d.get("flag", "")
                if flag:
                    tv.setText(f"{flag} {addr}:{info.port}")
            else:
                self._p._geo_fetch(addr)
        except Exception as e:
            _log(f"setProxy hook: {e}")


class _CellUpdateStatusHook(MethodHook):
    def __init__(self, plg):
        self._p = plg

    def after_hooked_method(self, param):
        try:
            cell = param.thisObject
            info = get_private_field(cell, "currentInfo")
            if not info:
                return
            vv = get_private_field(cell, "valueTextView")
            if vv is None:
                return
            addr, _, secret, _, _ = _info_fields(info)
            cur = str(vv.getText() or "")
            parts = []
            if self._p.get_setting("show_type", True):
                label = "MTProto" if secret else "SOCKS5"
                if label not in cur:
                    parts.append(label)
            if self._p.get_setting("show_geo", True):
                d = self._p._ip_cache.get(addr)
                isp = d.get("isp", "") if d else ""
                if isp and isp not in cur:
                    parts.append(isp)
                flag = d.get("flag", "") if d else ""
                tv = get_private_field(cell, "textView")
                if flag and tv is not None:
                    t = str(tv.getText() or "")
                    if t and not t.startswith(flag):
                        tv.setText(f"{flag} {t}")
                elif not d and addr:
                    self._p._geo_fetch(addr)
            if parts:
                vv.setText(cur + " · " + " · ".join(parts))
        except Exception as e:
            _log(f"updateStatus hook: {e}")


class _SponsorHook(MethodHook):
    def __init__(self, plg):
        self._p = plg

    def after_hooked_method(self, param):
        try:
            if not self._p.get_setting("hide_sponsor", True):
                return
            result = param.getResult()
            if result is None:
                return
            size = int(result.size())
            if size <= 0:
                return
            try:
                account = int(param.thisObject.getCurrentAccount())
            except Exception:
                account = int(UserConfig.selectedAccount)
            mc = MessagesController.getInstance(account)
            try:
                if int(mc.promoDialogType) != int(MessagesController.PROMO_TYPE_PROXY):
                    return
            except Exception:
                return

            def is_promo(item):
                try:
                    did = int(item.id)
                    return did != 0 and bool(mc.isPromoDialog(did, False))
                except Exception:
                    return False

            items = [result.get(i) for i in range(size)]
            if not any(it is not None and is_promo(it) for it in items):
                return
            from java.util import ArrayList

            filtered = ArrayList()
            for it in items:
                if it is not None and not is_promo(it):
                    filtered.add(it)
            param.setResult(filtered)
        except Exception as e:
            _log(f"sponsor hook: {e}")


_HEX_RE = re.compile(r"^[0-9a-fA-F]+$")


def _decode_secret(raw):
    compact = "".join(ch for ch in raw if not ch.isspace())
    if not compact:
        return compact, None
    if _HEX_RE.fullmatch(compact) and len(compact) % 2 == 0:
        try:
            return compact, bytes.fromhex(compact)
        except ValueError:
            return compact, None
    padded = compact.replace("-", "+").replace("_", "/")
    padded += "=" * ((4 - len(padded) % 4) % 4)
    try:
        return compact, base64.b64decode(padded, validate=False)
    except (ValueError, binascii.Error):
        return compact, None


class _SecretHook(MethodHook):
    def __init__(self, plg, secret_index):
        self._p = plg
        self._i = secret_index

    def before_hooked_method(self, param):
        try:
            if not self._p.get_setting("normalize_secret", True):
                return
            raw_value = param.args[self._i]
            if raw_value is None:
                return
            raw = str(raw_value)
            compact, decoded = _decode_secret(raw)
            if decoded is None:
                return
            hex_value = decoded.hex()
            if raw != hex_value:
                param.args[self._i] = hex_value
        except Exception:
            return


# ════════════════════════════════════════════════════════════════════
#  UI настроек в стиле карточек (шапка + сетка 2×2)
# ════════════════════════════════════════════════════════════════════

_LP = None


def _lp(w, h, weight=None):
    LP = jclass("android.widget.LinearLayout$LayoutParams")
    return LP(w, h, weight) if weight is not None else LP(w, h)


def _rounded(color_int, radius_dp, stroke_dp=0, stroke_color=0):
    GD = jclass("android.graphics.drawable.GradientDrawable")
    gd = GD()
    gd.setColor(color_int)
    gd.setCornerRadius(float(_dp(radius_dp)))
    if stroke_dp:
        gd.setStroke(_dp(stroke_dp), stroke_color)
    return gd


def _res_id(ctx, name):
    """Ищет иконку по имени; name может быть строкой или списком запасных имён."""
    names = [name] if isinstance(name, str) else list(name)
    for n in names:
        try:
            rid = int(getattr(R_tg.drawable, n))
            if rid:
                return rid
        except Exception:
            pass
        try:
            rid = int(ctx.getResources().getIdentifier(n, "drawable", ctx.getPackageName()))
            if rid:
                return rid
        except Exception:
            pass
    return 0


def _bold_face():
    try:
        return AndroidUtilities.bold()
    except Exception:
        try:
            return AndroidUtilities.getTypeface("fonts/rmedium.ttf")
        except Exception:
            return None


def _text(ctx, text, size_sp, color, bold=False):
    from android.widget import TextView

    tv = TextView(ctx)
    tv.setText(text)
    tv.setTextSize(1, size_sp)
    tv.setTextColor(color)
    if bold:
        face = _bold_face()
        if face is not None:
            tv.setTypeface(face)
    return tv


def _set_row_params(root):
    try:
        RLP = jclass("androidx.recyclerview.widget.RecyclerView$LayoutParams")
        root.setLayoutParams(RLP(-1, -2))
    except Exception:
        pass


def _noop_bind(view, item, divider, adapter, list_view):
    return None


def _create_header(context, list_view, current_account, class_guid, resources_provider):
    from android.widget import FrameLayout, ImageView, LinearLayout

    GD = jclass("android.graphics.drawable.GradientDrawable")
    Orientation = jclass("android.graphics.drawable.GradientDrawable$Orientation")

    outer = LinearLayout(context)
    outer.setOrientation(1)
    outer.setPadding(_dp(12), _dp(8), _dp(12), _dp(4))

    card = LinearLayout(context)
    card.setOrientation(1)
    card.setGravity(1)  # CENTER_HORIZONTAL
    card.setPadding(_dp(16), _dp(28), _dp(16), _dp(24))
    try:
        grad = GD(Orientation.TL_BR, jarray(jint)([_color(BRAND_2), _color(BRAND)]))
    except Exception:
        grad = _rounded(_color(BRAND), 28)
    grad.setCornerRadius(float(_dp(28)))
    card.setBackground(grad)

    badge = FrameLayout(context)
    circle = GD()
    circle.setShape(1)  # OVAL
    circle.setColor(jclass("android.graphics.Color").argb(70, 255, 255, 255))
    badge.setBackground(circle)
    FLP = jclass("android.widget.FrameLayout$LayoutParams")
    try:
        BackupImageView = jclass("org.telegram.ui.Components.BackupImageView")
        badge.addView(BackupImageView(context), FLP(_dp(72), _dp(72), 17))  # CENTER
    except Exception as e:
        _log(f"sticker view: {e}")
        icon = ImageView(context)
        rid = _res_id(context, "msg_proxy")
        if rid:
            icon.setImageResource(rid)
        icon.setColorFilter(_color(HEADER_TEXT))
        badge.addView(icon, FLP(_dp(44), _dp(44), 17))
    card.addView(badge, _lp(_dp(88), _dp(88)))

    title = _text(context, "Proxy Hub", 22, _color(HEADER_TEXT), bold=True)
    tlp = _lp(-2, -2)
    tlp.setMargins(0, _dp(14), 0, 0)
    card.addView(title, tlp)

    ver = _text(context, "v" + __version__, 13, _color(HEADER_TEXT))
    ver.setAlpha(0.7)
    vlp = _lp(-2, -2)
    vlp.setMargins(0, _dp(2), 0, 0)
    card.addView(ver, vlp)

    outer.addView(card, _lp(-1, -2))
    _set_row_params(outer)
    return outer


def _bind_header(view, item, divider, adapter, list_view):
    try:
        sticker = view.getChildAt(0).getChildAt(0).getChildAt(0)
        MDC = jclass("org.telegram.messenger.MediaDataController")
        MDC.getInstance(UserConfig.selectedAccount).setPlaceholderImageByIndex(
            sticker, STICKER_SET, STICKER_INDEX, "130_130"
        )
    except Exception as e:
        _log(f"sticker bind: {e}")


HEADER_FACTORY = SimpleSettingFactory(_create_header, _bind_header, is_clickable=False, is_shadow=False)


_CARD_DEFS = [
    ("Источники", "msg_link"),
    ("Таймер", "msg_recent"),
    ("Прокси", ["msg_proxy", "msg_proxy_on", "msg_data", "msg_language", "msg_info"]),
    ("Вид и хуки", "msg_settings"),
    ("Белые списки", ["msg_stats", "msg_online", "msg_info"]),
    ("Вкладка с прокси", ["msg_forward", "msg_arrowright", "msg_info"]),
]


def _card_subtitle(idx):
    p = _PLUGIN
    if p is None:
        return ""
    try:
        if idx == TAB_SOURCES:
            return f"{len(p._sources()) + len(p._web_sources())} шт."
        if idx == TAB_TIMER:
            return p._timer_label()
        if idx == TAB_TOOLS:
            return f"{len(_proxy_list_snapshot())} в списке"
        if idx == TAB_WL:
            return "Тест сайтов"
        if idx == TAB_PROXY_LIST:
            return "Показывает прокси активированные"
        return "Параметры"
    except Exception:
        return ""


def _select_tab(i):
    if _PLUGIN is None:
        return
    if i == TAB_PROXY_LIST:
        _PLUGIN._open_proxy_list()
        return
    _PLUGIN.set_setting("ui_tab", i, reload_settings=True)


def _create_cards(context, list_view, current_account, class_guid, resources_provider):
    from android.widget import ImageView, LinearLayout

    root = LinearLayout(context)
    root.setOrientation(1)
    root.setPadding(_dp(8), _dp(4), _dp(8), _dp(8))

    for r in range(3):
        row = LinearLayout(context)
        row.setOrientation(0)
        for c in range(2):
            idx = r * 2 + c
            title, icon_name = _CARD_DEFS[idx]
            card = LinearLayout(context)
            card.setOrientation(1)
            card.setPadding(_dp(16), _dp(14), _dp(12), _dp(14))
            card.setMinimumHeight(_dp(112))
            card.setClickable(True)

            icon = ImageView(context)
            rid = _res_id(context, icon_name)
            if rid:
                icon.setImageResource(rid)
            card.addView(icon, _lp(_dp(26), _dp(26)))

            t = _text(context, title, 16, Theme.getColor(Theme.key_windowBackgroundWhiteBlackText), bold=True)
            t.setSingleLine(True)
            t.setIncludeFontPadding(False)
            tl = _lp(-2, -2)
            tl.setMargins(0, _dp(12), 0, 0)
            card.addView(t, tl)

            s = _text(context, "", 12, Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
            s.setSingleLine(True)
            s.setIncludeFontPadding(False)
            try:
                s.setEllipsize(jclass("android.text.TextUtils$TruncateAt").END)
            except Exception:
                pass
            sl = _lp(-2, -2)
            sl.setMargins(0, _dp(3), 0, 0)
            card.addView(s, sl)

            card.setOnClickListener(OnClickListener(lambda _v, i=idx: _select_tab(i)))

            lp = _lp(0, -2, 1.0)
            lp.setMargins(_dp(4), _dp(4), _dp(4), _dp(4))
            row.addView(card, lp)
        root.addView(row, _lp(-1, -2))
    _set_row_params(root)
    return root


def _bind_cards(view, item, divider, adapter, list_view):
    try:
        p = _PLUGIN
        selected = int(p.get_setting("ui_tab", TAB_SOURCES)) if p else 0
        white = Theme.getColor(Theme.key_windowBackgroundWhite)
        text_c = Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)
        gray_c = Theme.getColor(Theme.key_windowBackgroundWhiteGrayIcon)
        brand = _color(BRAND)
        for r in range(3):
            row = view.getChildAt(r)
            for c in range(2):
                idx = r * 2 + c
                card = row.getChildAt(c)
                active = idx == selected and idx != TAB_PROXY_LIST
                card.setBackground(_rounded(white, 18, 2 if active else 0, brand))
                icon, title, sub = card.getChildAt(0), card.getChildAt(1), card.getChildAt(2)
                icon.setColorFilter(brand if active else gray_c)
                title.setTextColor(brand if active else text_c)
                sub.setText(_card_subtitle(idx))
    except Exception as e:
        _log(f"bind cards: {e}")


CARDS_FACTORY = SimpleSettingFactory(_create_cards, _bind_cards, is_clickable=False, is_shadow=False)


# ════════════════════════════════════════════════════════════════════
#  Список источников (сворачиваемый, с меню по нажатию / удержанию)
# ════════════════════════════════════════════════════════════════════

_SRC_UI = {}


def _src_toggle():
    p = _PLUGIN
    if p is None:
        return
    p.set_setting("src_collapsed", not bool(p.get_setting("src_collapsed", False)))
    _src_apply()


def _src_row(ctx, entry):
    from android.widget import ImageView, LinearLayout

    p = _PLUGIN
    text_c = Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)
    sub_c = Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2)
    gray_c = Theme.getColor(Theme.key_windowBackgroundWhiteGrayIcon)

    row = LinearLayout(ctx)
    row.setOrientation(0)
    row.setGravity(16)
    row.setPadding(_dp(16), _dp(10), _dp(12), _dp(10))
    row.setClickable(True)
    try:
        row.setBackground(Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector), 2))
    except Exception:
        pass

    icon = ImageView(ctx)
    names = ["msg_channel", "msg_groups", "msg_link"] if entry["kind"] == "tg" else ["msg_link", "msg_language", "msg_info"]
    rid = _res_id(ctx, names)
    if rid:
        icon.setImageResource(rid)
    icon.setColorFilter(gray_c)
    ilp = _lp(_dp(24), _dp(24))
    ilp.setMargins(0, 0, _dp(14), 0)
    row.addView(icon, ilp)

    col = LinearLayout(ctx)
    col.setOrientation(1)
    title = _text(ctx, entry["title"], 15, text_c)
    title.setSingleLine(True)
    title.setIncludeFontPadding(False)
    sub_txt = entry["label"]
    st = p._status.get(entry["key"]) if p else None
    if st:
        sub_txt += " · " + st
    sub = _text(ctx, sub_txt, 12, sub_c)
    sub.setSingleLine(True)
    sub.setIncludeFontPadding(False)
    try:
        trunc = jclass("android.text.TextUtils$TruncateAt").END
        title.setEllipsize(trunc)
        sub.setEllipsize(trunc)
    except Exception:
        pass
    col.addView(title, _lp(-1, -2))
    slp = _lp(-1, -2)
    slp.setMargins(0, _dp(2), 0, 0)
    col.addView(sub, slp)
    row.addView(col, _lp(0, -2, 1.0))

    row.setOnClickListener(OnClickListener(lambda _v, e=entry: p._source_menu(e)))
    row.setOnLongClickListener(_LongClick(lambda e=entry: p._source_menu(e)))
    return row


def _src_apply():
    ui = _SRC_UI
    p = _PLUGIN
    if not ui or p is None or "root" not in ui:
        return
    try:
        ctx = ui["root"].getContext()
        ui["card"].setBackground(_rounded(Theme.getColor(Theme.key_windowBackgroundWhite), 18))
        entries = p._source_entries()
        collapsed = bool(p.get_setting("src_collapsed", False))
        ui["title"].setText(f"Список источников · {len(entries)}")
        ui["title"].setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
        ui["chev"].setText("▸" if collapsed else "▾")
        ui["chev"].setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayIcon))
        body = ui["body"]
        body.removeAllViews()
        body.setVisibility(8 if collapsed else 0)
        if collapsed:
            return
        if not entries:
            hint = _text(ctx, "Источников пока нет. Нажмите «Добавить источник».", 13,
                         Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
            hint.setPadding(_dp(16), _dp(6), _dp(16), _dp(16))
            body.addView(hint, _lp(-1, -2))
            return
        for e in entries:
            body.addView(_src_row(ctx, e), _lp(-1, -2))
        pad = _text(ctx, "", 1, 0)
        body.addView(pad, _lp(-1, _dp(6)))
    except Exception as e:
        _log(f"src apply: {e}")


def _create_sources(context, list_view, current_account, class_guid, resources_provider):
    from android.widget import LinearLayout

    root = LinearLayout(context)
    root.setOrientation(1)
    root.setPadding(_dp(12), _dp(4), _dp(12), _dp(4))

    card = LinearLayout(context)
    card.setOrientation(1)

    head = LinearLayout(context)
    head.setOrientation(0)
    head.setGravity(16)
    head.setPadding(_dp(16), _dp(14), _dp(16), _dp(14))
    head.setClickable(True)
    title = _text(context, "Список источников", 15, 0, bold=True)
    head.addView(title, _lp(0, -2, 1.0))
    chev = _text(context, "▾", 18, 0)
    head.addView(chev, _lp(-2, -2))
    head.setOnClickListener(OnClickListener(lambda _v: _src_toggle()))
    card.addView(head, _lp(-1, -2))

    body = LinearLayout(context)
    body.setOrientation(1)
    card.addView(body, _lp(-1, -2))

    root.addView(card, _lp(-1, -2))
    _set_row_params(root)
    _SRC_UI.clear()
    _SRC_UI.update(root=root, card=card, title=title, chev=chev, body=body)
    return root


def _bind_sources(view, item, divider, adapter, list_view):
    _src_apply()


SRC_FACTORY = SimpleSettingFactory(_create_sources, _bind_sources, is_clickable=False, is_shadow=False)


