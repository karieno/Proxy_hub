class _NativeTimeDelegate(java.dynamic_proxy(RequestTimeDelegate)):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def run(self, time_val):
        try:
            self._fn(time_val)
        except Exception as e:
            _log(f"delegate cb: {e}")


# ════════════════════════════════════════════════════════════════════
#  Java-прокси, диалоги, уведомление с таймером
# ════════════════════════════════════════════════════════════════════

class _Runnable(java.dynamic_proxy(jclass("java.lang.Runnable"))):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def run(self):
        try:
            self._fn()
        except Exception as e:
            _log(f"runnable: {e}")


class _DialogClick(java.dynamic_proxy(jclass("android.content.DialogInterface$OnClickListener"))):
    def __init__(self, fn=None):
        super().__init__()
        self._fn = fn

    def onClick(self, dialog, which):
        try:
            if self._fn:
                self._fn(int(which))
        except Exception as e:
            _log(f"dialog click: {e}")


class _LongClick(java.dynamic_proxy(jclass("android.view.View$OnLongClickListener"))):
    def __init__(self, fn):
        super().__init__()
        self._fn = fn

    def onLongClick(self, view):
        try:
            self._fn()
        except Exception as e:
            _log(f"long click: {e}")
        return True


def _later(fn, delay):
    """Выполнить fn в UI-потоке через delay секунд."""
    threading.Timer(delay, lambda: run_on_ui_thread(fn)).start()


def _is_dark():
    try:
        return bool(Theme.isCurrentThemeDark())
    except Exception:
        return True


def _activity():
    try:
        fr = get_last_fragment()
        return fr.getParentActivity() if fr else None
    except Exception:
        return None


def _dialog_builder(act):
    return jclass("android.app.AlertDialog$Builder")(act, 4 if _is_dark() else 5)


def _choose(title, labels, on_pick):
    """Меню выбора (UI-поток). on_pick(index)."""
    act = _activity()
    if act is None:
        return
    b = _dialog_builder(act)
    b.setTitle(title)
    b.setItems(jarray(jclass("java.lang.CharSequence"))(list(labels)), _DialogClick(on_pick))
    b.show()


def _input_dialog(title, hint, positive, on_ok):
    """Диалог с многострочным полем (UI-поток). on_ok(text)."""
    act = _activity()
    if act is None:
        return
    from android.widget import EditText as _AndroidEdit, FrameLayout

    et = _AndroidEdit(act)
    et.setHint(hint)
    et.setMinLines(4)
    et.setGravity(51)  # TOP | LEFT
    et.setInputType(1 | 131072)  # text | multiline
    box = FrameLayout(act)
    box.setPadding(_dp(20), _dp(8), _dp(20), 0)
    box.addView(et)
    b = _dialog_builder(act)
    b.setTitle(title)
    b.setView(box)
    b.setPositiveButton(positive, _DialogClick(lambda w: on_ok(str(et.getText()))))
    b.setNegativeButton("Отмена", _DialogClick())
    b.show()


def _confirm_dialog(title, message, ok_text, on_ok):
    frag = get_last_fragment()
    act = frag.getParentActivity() if frag else None
    if not act:
        return
    b = AlertDialogBuilder(act)
    b.set_title(title)
    b.set_message(message)

    def _ok(bld, which):
        bld.dismiss()
        on_ok()

    b.set_positive_button(ok_text, _ok)
    b.set_negative_button("Отмена", lambda bld, which: bld.dismiss())
    b.show()


def _timed_bulletin(text, button_text, on_click, seconds=5):
    """Уведомление Telegram с кольцом обратного отсчёта и кнопкой (UI-поток).
    Возвращает True, если удалось показать."""
    try:
        fragment = get_last_fragment()
        ctx = fragment.getParentActivity() if fragment else None
        if ctx is None:
            return False
        Bulletin = jclass("org.telegram.ui.Components.Bulletin")
        LottieLayout = jclass("org.telegram.ui.Components.Bulletin$LottieLayout")
        UndoButton = jclass("org.telegram.ui.Components.Bulletin$UndoButton")
        try:
            rp = fragment.getResourceProvider()
        except Exception:
            rp = None
        layout = LottieLayout(ctx, rp)
        layout.textView.setText(text)
        try:
            layout.setTimer()
        except Exception as e:
            _log(f"setTimer: {e}")
        btn = None
        for args in ((ctx, True), (ctx, True, rp)):
            try:
                btn = UndoButton(*args)
                break
            except Exception:
                continue
        if btn is None:
            return False
        try:
            btn.setText(button_text)
        except Exception as e:
            _log(f"btn.setText: {e}")
        btn.setUndoAction(_Runnable(on_click))
        layout.setButton(btn)
        Bulletin.make(fragment, layout, int(seconds * 1000)).show()
        return True
    except Exception as e:
        _log(f"timed bulletin: {e}")
        return False


# ════════════════════════════════════════════════════════════════════
#  Автопилот: состояние и «тихие» ядра действий
# ════════════════════════════════════════════════════════════════════

_PILOT = {"running": False, "cancel": False, "step": 0, "total": 0, "text": ""}
_PILOT_UI = {}
_PILOT_LOCK = threading.Lock()


def _ui_call(fn, timeout=40):
    """Выполняет fn в UI-потоке и ждёт результат (вызывать только из фонового потока)."""
    box, ev = {}, threading.Event()

    def run():
        try:
            box["r"] = fn()
        except Exception as e:
            box["e"] = e
        finally:
            ev.set()

    run_on_ui_thread(run)
    if not ev.wait(timeout):
        raise TimeoutError("UI-поток не ответил")
    if "e" in box:
        raise box["e"]
    return box.get("r")


def _rank(proxies):
    """Рабочие прокси от самого быстрого к самому медленному."""
    def key(p):
        try:
            ping = int(getattr(p, "ping", 0) or 0)
        except Exception:
            ping = 0
        return ping if ping > 0 else 10 ** 9

    return sorted(proxies, key=key)


def _dedupe_core():
    seen, dups = set(), []
    for p in _proxy_list_snapshot():
        k = ":".join(str(x) for x in _info_fields(p))
        if k in seen:
            dups.append(p)
        else:
            seen.add(k)
    return _delete_proxies(dups) if dups else 0


def _sort_core():
    SharedConfig.loadProxyList()
    al = SharedConfig.proxyList
    items = _jlist(al)
    if len(items) <= 1:
        return False

    def sk(i):
        av = bool(getattr(i, "available", False))
        p = int(getattr(i, "ping", 0) or 0)
        return (1, 10 ** 9) if (not av or p <= 0) else (0, p)

    items.sort(key=sk)
    al.clear()
    for it in items:
        al.add(it)
    _save_proxies()
    _notify_proxies_changed()
    return True


def _optimize_core():
    mod = 0
    for p in _proxy_list_snapshot():
        changed = False
        secret = str(getattr(p, "secret", "") or "")
        if len(secret) == 32 and all(c in "0123456789abcdefABCDEF" for c in secret):
            p.secret = "dd" + secret
            changed = True
        addr = str(getattr(p, "address", "") or "")
        if addr and not re.match(r"^\d{1,3}(\.\d{1,3}){3}$", addr):
            try:
                ip = socket.gethostbyname(addr)
                if ip != addr:
                    p.address = ip
                    changed = True
            except Exception:
                pass
        if changed:
            mod += 1
    if mod:
        _save_proxies()
        _notify_proxies_changed()
    return mod


def _connect_proxy(info):
    """Включает прокси и делает его текущим. Возвращает True, если удалось."""
    a, po, secret, user, pw = _info_fields(info)
    if not a or not po:
        return False
    ok = False
    try:
        SharedConfig.setCurrentProxy(info)
        ok = True
    except Exception as e:
        _log(f"setCurrentProxy: {e}")
    try:
        SharedConfig.currentProxy = info
    except Exception:
        pass
    try:
        ed = MessagesController.getGlobalMainSettings().edit()
        ed.putBoolean("proxy_enabled", True)
        ed.putString("proxy_ip", a)
        ed.putString("proxy_pass", pw)
        ed.putString("proxy_user", user)
        ed.putInt("proxy_port", int(po))
        ed.putString("proxy_secret", secret)
        ed.apply()
        ok = True
    except Exception as e:
        _log(f"proxy prefs: {e}")
    try:
        ConnectionsManager.setProxySettings(True, a, int(po), user, pw, secret)
        ok = True
    except Exception as e:
        _log(f"setProxySettings: {e}")
    _save_proxies()
    _notify_proxies_changed()
    return ok


def _fmt_duration(sec):
    sec = int(sec)
    return f"{sec} с" if sec < 60 else f"{sec // 60} мин {sec % 60} с"


