    def create_settings(self) -> List[Any]:
        tab = int(self.get_setting("ui_tab", TAB_SOURCES))
        items: List[Any] = [
            Custom(factory=HEADER_FACTORY.instance.java),
            Custom(factory=CARDS_FACTORY.instance.java),
        ]
        builders = {
            TAB_SOURCES: self._tab_sources,
            TAB_TIMER: self._tab_timer,
            TAB_TOOLS: self._tab_tools,
            TAB_VIEW: self._tab_view,
            TAB_WL: self._tab_wl,
        }
        items += builders.get(tab, self._tab_sources)()
        items += [
            Divider(),
            Header(text="О плагине"),
            Text(
                text="Информация о Proxy Hub",
                subtext="Версия " + __version__ + " · нажмите, чтобы посмотреть",
                icon="msg_info",
                on_click=lambda v: self._show_about(),
            ),
        ]
        return items

    def _show_about(self):
        act = _activity()
        if act is None:
            BulletinHelper.show_error("Не удалось открыть информацию о плагине")
            return
        message = (
            f"Версия: {__version__}\n"
            f"Автор: {__author__}\n\n"
            "Proxy Hub собирает прокси из Telegram и веб-источников, "
            "проверяет их доступность, управляет списком, а также показывает "
            "сведения о подключении и результат проверки белых списков."
        )
        try:
            builder = _dialog_builder(act)
            builder.setTitle("О Proxy Hub")
            builder.setMessage(message)
            builder.setPositiveButton("Закрыть", _DialogClick())
            builder.show()
        except Exception as e:
            _log(f"about dialog: {e}")
            BulletinHelper.show_error(f"Не удалось показать информацию: {e}")

